# ACE-Stream 5090 BXP - copy to .env and fill every value.
# NEVER commit .env or paste secrets into chat.

# --- SaladCloud ---------------------------------------------------------------
# dashboard > API keys; header Salad-Api-Key
SALAD_API_KEY=

# --- Job queue (Cloudflare Worker) --------------------------------------------
# URL printed by `npx wrangler deploy` inside queue-worker/
QUEUE_BASE_URL=
# must match the ADMIN_KEY secret you set with `wrangler secret put ADMIN_KEY`
ADMIN_KEY=

# --- Cloudflare R2 ------------------------------------------------------------
# Object Read & Write token scoped to your bucket (Access Key ID / Secret)
R2_ENDPOINT_URL=https://abd12cd58366e2d99a202218328b1340.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=music-generations

# --- Docker image -------------------------------------------------------------
DOCKERHUB_USER=
ACESTEP_IMAGE_TAG=latest

# --- Worker runtime limits ----------------------------------------------------
# hard cap per job (submit->render->download) in seconds
JOB_TIMEOUT_SECONDS=900
# deadman switch: node force-exits after this many seconds (stops billing if frozen)
MAX_RUNTIME_SECONDS=21600

# --- GPU pool -----------------------------------------------------------------
# Comma-separated Salad GPU class UUIDs used by `up` / `run` (camelCase
# gpu_classes in the create payload; snake_case silently vanishes).
# Unset default: RTX 5090 (32 GB) pool only.
# Both classes - 4090 second as a faster-to-allocate fallback; acestep-v15-xl
# fits its 24 GB:
#GPU_CLASSES=851399fb-7329-4195-a042-d6514b28cf33,ed563892-aacd-40f5-80b7-90c9be6c759b

# --- Render output ------------------------------------------------------------
# Audio container the sidecar uploads (sidecar maps wav/flac/mp3 content types)
OUTPUT_FORMAT=wav

# --- Kanban progress hook (optional) -------------------------------------------
# `watch` POSTs per-tick progress here, mirroring the PCBGenius kanban worker's
# /api/update shape. Leave empty to disable. A browser User-Agent is sent
# automatically (the board's WAF rejects non-browser agents with 403/1010).
#KANBAN_PROGRESS_URL=https://kanban.louie-ibunia-va.workers.dev/api/update
